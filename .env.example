# --- Language model -----------------------------------------------------------

# Gemini is the default because it has a genuine free tier, so this pipeline
# runs for anyone with their own key and no spend. Get one at
# https://aistudio.google.com/apikey
#
# The free tier is Flash-only, at 10 requests per minute and 250 per day. A kit
# costs roughly four calls, so a free key is good for about sixty cases a day.
GEMINI_API_KEY=

# Anthropic is supported for development against a key you already hold. It has
# no free API tier, so leave it unset unless you mean to spend money.
# ANTHROPIC_API_KEY=

# gemini | anthropic. Optional: with exactly one key set the provider is
# inferred from it, and with both set Gemini wins.
# LLM_PROVIDER=gemini

# Defaults to gemini-2.5-flash or claude-sonnet-5 depending on the provider.
# claude-haiku-4-5 is the cheaper Anthropic option.
# LLM_MODEL=

# Points the provider call somewhere else: a gateway, a proxy, or the local
# test double the batch command's end-to-end test runs against.
# LLM_BASE_URL=

# Per-minute allowances, which cap tokens as well as requests. The defaults
# under-claim deliberately: one shared budget across all concurrent cases costs
# a little throughput, being throttled costs a retry.
# LLM_REQUESTS_PER_MINUTE=10
# LLM_TOKENS_PER_MINUTE=200000

# --- Server -------------------------------------------------------------------

# Signs session cookies. The compose file falls back to a development value, and
# the server refuses to boot with that fallback when NODE_ENV is production.
# SESSION_SECRET=

# Where the published ports land on your machine. Move them if something else is
# already holding 3000 or 4000; compose keeps the API and the browser in
# agreement about the addresses for you.
# WEB_PORT=3000
# API_PORT=4000

# Only needed outside compose, which wires these up itself.
# PORT=4000
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=prepkit
# The single browser origin allowed to call the API with credentials.
# WEB_ORIGIN=http://localhost:3000

# --- Retrieval safety ---------------------------------------------------------

# Company sites are untrusted pages from the open internet, so private and
# loopback addresses are refused whenever NODE_ENV is production, and reachable
# everywhere else because the batch fixtures may be served from a local address.
# Set this explicitly to override either default.
# ALLOW_PRIVATE_HOSTS=false

# --- Batch run tuning ---------------------------------------------------------

# Cases generated in parallel. Kept low because every case shares one provider
# rate limit.
EVALUATE_CONCURRENCY=2

# Hard ceiling per case. A case that exceeds it is recorded as failed with code
# TIMEOUT rather than stalling the run.
CASE_TIMEOUT_MS=170000
