# Batch run tuning. Both are optional; the defaults keep five cases inside the
# fifteen-minute budget required by the assessment brief.

# Cases generated in parallel. Kept low because every case shares one provider
# rate limit.
EVALUATE_CONCURRENCY=2

# Hard ceiling per case. A case that exceeds it is recorded as failed with code
# TIMEOUT rather than stalling the run.
CASE_TIMEOUT_MS=170000
